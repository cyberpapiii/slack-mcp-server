# User OAuth Token (starts with xoxp-)
SLACK_MCP_XOXP_TOKEN="" # Replace with your user OAuth token

# Bot OAuth Token (starts with xoxb-)
SLACK_MCP_XOXB_TOKEN="" # Replace with your bot token

# Session-based tokens (browser tokens)
SLACK_MCP_XOXC_TOKEN="" # Replace with your token
SLACK_MCP_XOXD_TOKEN="" # Replace with your token

# Bearer token for the sse and http transports. These transports refuse to
# start unless this is set (see the opt-out below). The stdio transport
# ignores it. Replaces an older, now-deprecated key name; see AGENTS.md.
SLACK_MCP_API_KEY="" # Replace with your API key

# Serve sse/http with NO authentication. Must be exactly "true"; "1" and
# "yes" are rejected. Local loopback development only: anyone who can reach
# the port gets full Slack access. Leave commented out.
#SLACK_MCP_ALLOW_UNAUTHENTICATED=true

# --- Channel allow/block lists for write tools ----------------------------
# Which tools register is decided only by SLACK_MCP_ENABLED_TOOLS or
# SLACK_MCP_TOOL_PRESET (daily-power, read-only, is the default). The three
# variables below do not enable or disable tools; they restrict which channels
# an already-enabled write tool may touch. Empty or "true" = every channel;
# "C1,C2" = only those; "!C1,!C2" = all except those. "false" is read as a
# channel list and denies every channel.

# conversations_add_message and the messages_* lifecycle tools.
#SLACK_MCP_ADD_MESSAGE_TOOL=true

# reactions_add, reactions_remove.
#SLACK_MCP_REACTION_TOOL=true

# channels_rename, channels_set_topic, channels_set_purpose, channels_archive.
#SLACK_MCP_CHANNEL_MANAGEMENT_TOOL=true

