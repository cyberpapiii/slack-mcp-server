# User OAuth Token (starts with xoxp-)
SLACK_MCP_XOXP_TOKEN="" # Replace with your user OAuth token

# Bot OAuth Token (starts with xoxb-)
SLACK_MCP_XOXB_TOKEN="" # Replace with your bot token

# Session-based tokens (browser tokens)
SLACK_MCP_XOXC_TOKEN="" # Replace with your actual token
SLACK_MCP_XOXD_TOKEN="" # Replace with your actual token

# Bearer token for the sse and http transports. These transports refuse to
# start unless this is set (see the opt-out below). The stdio transport
# ignores it. Replaces an older, now-deprecated key name; see AGENTS.md.
SLACK_MCP_API_KEY="" # Replace with your actual API key

# Serve sse/http with NO authentication. Must be exactly "true"; "1" and
# "yes" are rejected. Local loopback development only: anyone who can reach
# the port gets full Slack access. Leave commented out.
#SLACK_MCP_ALLOW_UNAUTHENTICATED=true

# --- Side-effecting tool gates -------------------------------------------
# All are OFF unless set; that default is the security model. Uncomment only
# what you need. A tool named in SLACK_MCP_ENABLED_TOOLS is enabled by that
# allowlist alone, without the gate var below.

# Post messages. "true"/"1", or a comma-separated channel allowlist
# ("!C123..." negates). Gates conversations_add_message.
#SLACK_MCP_ADD_MESSAGE_TOOL=true

# Add/remove reactions. Same value format as above.
# Gates reactions_add, reactions_remove.
#SLACK_MCP_REACTION_TOOL=true

# Download attachment bytes. "true", "1", or "yes".
# Gates attachment_get_data.
#SLACK_MCP_ATTACHMENT_TOOL=true

# Mark conversations as read. "true", "1", or "yes".
# Gates conversations_mark.
#SLACK_MCP_MARK_TOOL=true

# Join/leave channels. Any non-empty value. Gates conversations_join,
# conversations_leave.
#SLACK_MCP_CHANNEL_MEMBERSHIP_TOOL=true

# Create/modify user groups. Any non-empty value. Gates usergroups_create,
# usergroups_update, usergroups_users_update.
#SLACK_MCP_USERGROUPS_WRITE_TOOL=true

# List files. Any non-empty value. Gates files_list.
#SLACK_MCP_FILES_LIST_TOOL=true
