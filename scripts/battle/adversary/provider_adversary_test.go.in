package provider

import (
	"context"
	"errors"
	"fmt"
	"sync"
	"sync/atomic"
	"testing"
	"time"

	"github.com/korotovsky/slack-mcp-server/pkg/provider/edge"
	"github.com/slack-go/slack"
	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
)

type advUsersClient struct {
	SlackAPI

	calls        atomic.Int32
	bootCalls    atomic.Int32
	firstEnter   chan struct{}
	firstRelease chan struct{}
}

func (c *advUsersClient) GetUsersContext(ctx context.Context, _ ...slack.GetUsersOption) ([]slack.User, error) {
	call := c.calls.Add(1)
	if call == 1 && c.firstEnter != nil {
		close(c.firstEnter)
		select {
		case <-c.firstRelease:
		case <-ctx.Done():
			return nil, ctx.Err()
		}
	}
	select {
	case <-ctx.Done():
		return nil, ctx.Err()
	default:
		return []slack.User{{ID: fmt.Sprintf("U%03d", call), Name: fmt.Sprintf("user_%03d", call)}}, nil
	}
}

func (c *advUsersClient) ClientUserBoot(context.Context) (*edge.ClientUserBootResponse, error) {
	c.bootCalls.Add(1)
	return &edge.ClientUserBootResponse{}, nil
}

func TestADV001ConcurrentForegroundWarmCoalescesDependencyWork(t *testing.T) {
	const callers = 24
	client := &advUsersClient{}
	ap := newTestApiProvider(client, emptyUsersCache())
	ap.usersCachePath = t.TempDir() + "/users.json"

	start := make(chan struct{})
	errs := make(chan error, callers)
	var wg sync.WaitGroup
	for i := 0; i < callers; i++ {
		wg.Add(1)
		go func() {
			defer wg.Done()
			<-start
			errs <- ap.RefreshUsers(context.Background())
		}()
	}

	begin := time.Now()
	close(start)
	wg.Wait()
	close(errs)

	for err := range errs {
		require.NoError(t, err)
	}
	elapsed := time.Since(begin)
	t.Logf("callers=%d users_api_calls=%d connect_enrichment_calls=%d elapsed=%s",
		callers, client.calls.Load(), client.bootCalls.Load(), elapsed)

	assert.Equal(t, int32(1), client.calls.Load(),
		"overlapping foreground warms should share one users API call")
	assert.Equal(t, int32(1), client.bootCalls.Load(),
		"overlapping foreground warms should share one enrichment call")
	snapshot := ap.usersSnapshot.Load()
	require.NotNil(t, snapshot)
	assert.Equal(t, "user_001", snapshot.Users["U001"].Name)
}

type advChannelsClient struct {
	SlackAPI

	calls        atomic.Int32
	firstEnter   chan struct{}
	firstRelease chan struct{}
}

func (c *advChannelsClient) GetConversationsContext(ctx context.Context, _ *slack.GetConversationsParameters) ([]slack.Channel, string, error) {
	call := c.calls.Add(1)
	if call == 1 {
		close(c.firstEnter)
		select {
		case <-c.firstRelease:
		case <-ctx.Done():
			return nil, "", ctx.Err()
		}
	}

	var channel slack.Channel
	channel.ID = fmt.Sprintf("C%03d", call)
	channel.Name = fmt.Sprintf("channel_%03d", call)
	channel.NameNormalized = channel.Name
	return []slack.Channel{channel}, "", nil
}

func TestADV003OverlappingColdChannelWarmsCoalesceDependencyWork(t *testing.T) {
	const callers = 24
	client := &advChannelsClient{
		firstEnter:   make(chan struct{}),
		firstRelease: make(chan struct{}),
	}
	ap := newTestApiProvider(client, emptyUsersCache())
	ap.channelsCachePath = t.TempDir() + "/channels.json"

	start := make(chan struct{})
	errs := make(chan error, callers)
	var ready sync.WaitGroup
	var done sync.WaitGroup
	ready.Add(callers)
	done.Add(callers)
	for i := 0; i < callers; i++ {
		go func() {
			defer done.Done()
			ready.Done()
			<-start
			errs <- ap.RefreshChannels(context.Background())
		}()
	}
	ready.Wait()
	close(start)
	select {
	case <-client.firstEnter:
	case <-time.After(2 * time.Second):
		t.Fatal("first channel warm never entered dependency")
	}
	time.Sleep(50 * time.Millisecond)

	begin := time.Now()
	close(client.firstRelease)
	done.Wait()
	close(errs)
	for err := range errs {
		require.NoError(t, err)
	}

	elapsed := time.Since(begin)
	t.Logf("callers=%d channel_api_calls=%d serialized_tail=%s",
		callers, client.calls.Load(), elapsed)
	assert.Equal(t, int32(1), client.calls.Load(),
		"overlapping cold channel warms should share one channels API call")
	snapshot := ap.channelsSnapshot.Load()
	require.NotNil(t, snapshot)
	assert.Equal(t, "#channel_001", snapshot.Channels["C001"].Name)
}

func TestADV003CancelledChannelWarmStopsWaitingForSlowDependency(t *testing.T) {
	client := &advChannelsClient{
		firstEnter:   make(chan struct{}),
		firstRelease: make(chan struct{}),
	}
	ap := newTestApiProvider(client, emptyUsersCache())
	ap.channelsCachePath = t.TempDir() + "/channels.json"

	firstDone := make(chan error, 1)
	go func() {
		firstDone <- ap.RefreshChannels(context.Background())
	}()
	select {
	case <-client.firstEnter:
	case <-time.After(2 * time.Second):
		t.Fatal("first channel warm never entered dependency")
	}

	ctx, cancel := context.WithTimeout(context.Background(), 25*time.Millisecond)
	defer cancel()
	secondDone := make(chan error, 1)
	begin := time.Now()
	go func() {
		secondDone <- ap.RefreshChannels(ctx)
	}()

	select {
	case err := <-secondDone:
		require.ErrorIs(t, err, context.DeadlineExceeded)
	case <-time.After(100 * time.Millisecond):
		t.Fatal("cancelled queued channel warm did not return promptly")
	}
	returned := time.Since(begin)
	close(client.firstRelease)

	require.NoError(t, <-firstDone)
	t.Logf("channel_deadline=25ms returned=%s dependency_calls=%d",
		returned, client.calls.Load())
	assert.Less(t, returned, 100*time.Millisecond)
	assert.Equal(t, int32(1), client.calls.Load(),
		"cancelled channel waiter should not start another dependency call")
}

type advChannelLeaderDeadlineClient struct {
	SlackAPI

	calls      atomic.Int32
	firstEnter chan struct{}
}

func (c *advChannelLeaderDeadlineClient) GetConversationsContext(ctx context.Context, _ *slack.GetConversationsParameters) ([]slack.Channel, string, error) {
	call := c.calls.Add(1)
	if call == 1 {
		close(c.firstEnter)
		<-ctx.Done()
		return nil, "", ctx.Err()
	}

	timer := time.NewTimer(25 * time.Millisecond)
	defer timer.Stop()
	select {
	case <-timer.C:
		channel := slack.Channel{}
		channel.ID = "C001"
		channel.Name = "retry_success"
		channel.NameNormalized = channel.Name
		return []slack.Channel{channel}, "", nil
	case <-ctx.Done():
		return nil, "", ctx.Err()
	}
}

func TestADV004ChannelLeaderDeadlineOwnsSharedDependency(t *testing.T) {
	const waiters = 23
	client := &advChannelLeaderDeadlineClient{firstEnter: make(chan struct{})}
	ap := newTestApiProvider(client, emptyUsersCache())
	ap.channelsCachePath = t.TempDir() + "/channels.json"

	leaderCtx, cancelLeader := context.WithTimeout(context.Background(), 25*time.Millisecond)
	defer cancelLeader()
	leaderDone := make(chan error, 1)
	go func() {
		leaderDone <- ap.RefreshChannels(leaderCtx)
	}()
	select {
	case <-client.firstEnter:
	case <-time.After(2 * time.Second):
		t.Fatal("channel leader never entered dependency")
	}

	start := make(chan struct{})
	errs := make(chan error, waiters)
	var ready sync.WaitGroup
	var done sync.WaitGroup
	ready.Add(waiters)
	done.Add(waiters)
	for i := 0; i < waiters; i++ {
		go func() {
			defer done.Done()
			ready.Done()
			<-start
			errs <- ap.RefreshChannels(context.Background())
		}()
	}
	ready.Wait()
	begin := time.Now()
	close(start)

	require.ErrorIs(t, <-leaderDone, context.DeadlineExceeded)
	done.Wait()
	close(errs)
	for err := range errs {
		require.NoError(t, err)
	}

	elapsed := time.Since(begin)
	t.Logf("channel_leader_deadline=25ms waiters=%d dependency_calls=%d waiter_completion=%s",
		waiters, client.calls.Load(), elapsed)
	assert.Equal(t, int32(2), client.calls.Load(),
		"channel leader deadline should fail shared attempt; live waiters should share one retry")
	assert.Equal(t, "#retry_success", ap.channelsSnapshot.Load().Channels["C001"].Name)
}

