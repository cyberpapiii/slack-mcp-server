func TestADV004PersistentChannelFailureSerializesOneAttemptPerCaller(t *testing.T) {
	const callers = 24
	client := &advPersistentChannelFailureClient{
		firstEnter:   make(chan struct{}),
		firstRelease: make(chan struct{}),
	}
	ap := newTestApiProvider(client, emptyUsersCache())
	ap.channelsCachePath = t.TempDir() + "/channels.json"

	start := make(chan struct{})
	errs := make(chan error, callers)
	var ready sync.WaitGroup
	var done sync.WaitGroup
	ready.Add(callers)
	done.Add(callers)
	for i := 0; i < callers; i++ {
		go func() {
			defer done.Done()
			ready.Done()
			<-start
			errs <- ap.RefreshChannels(context.Background())
		}()
	}
	ready.Wait()
	close(start)
	select {
	case <-client.firstEnter:
	case <-time.After(2 * time.Second):
		t.Fatal("first channel attempt never entered dependency")
	}
	time.Sleep(50 * time.Millisecond)

	begin := time.Now()
	close(client.firstRelease)
	done.Wait()
	close(errs)
	for err := range errs {
		require.ErrorContains(t, err, "persistent channels failure")
	}

	elapsed := time.Since(begin)
	t.Logf("callers=%d persistent_channel_failure_dependency_calls=%d serialized_tail=%s",
		callers, client.calls.Load(), elapsed)
	assert.Equal(t, int32(callers), client.calls.Load(),
		"persistent channel failure should preserve one serialized dependency attempt per caller")
}

